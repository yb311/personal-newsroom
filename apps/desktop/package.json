{
  "name": "@pnr/desktop",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --outdir=dist --out-extension:.js=.cjs --external:electron --external:better-sqlite3 --external:sqlite-vec --external:jsdom --external:defuddle --external:@extractus/article-extractor --external:fast-xml-parser --external:rsshub",
    "build:renderer": "vite build",
    "build": "npm run copy:catalog && npm run build:main && npm run build:renderer",
    "dev": "npm run copy:catalog && npm run build:main && electron .",
    "start": "electron .",
    "copy:catalog": "mkdir -p catalogs && cp ../../catalogs/data/feeds.json catalogs/feeds.json"
  },
  "dependencies": {
    "@pnr/core": "*",
    "@pnr/feed": "*",
    "@pnr/reader": "*",
    "@pnr/store": "*",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "@pnr/ai": "*",
    "@pnr/watch": "*",
    "@pnr/recall": "*",
    "@pnr/generate": "*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "esbuild": "^0.28.2",
    "vite": "^8.3.0"
  }
}
