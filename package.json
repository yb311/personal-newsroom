    "test:watch": "node --experimental-strip-types dev/watch.test.ts",
    "test:pipeline": "node --experimental-strip-types dev/pipeline.test.ts",
    "test:generate": "node --experimental-strip-types dev/generate.test.ts",
    "test:flash-deep": "node --experimental-strip-types dev/flash-deep.test.ts",
