{
  "name": "personal-newsroom",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "reader:build": "scripts/build-reader.sh",
    "reader:test": "cd native/reader && go test ./...",
    "doctor": "node --experimental-strip-types packages/core/src/doctor.ts",
    "catalog:build": "node --experimental-strip-types catalogs/build.ts",
    "catalog:verify": "node --experimental-strip-types catalogs/verify.ts",
    "test:schema": "node --experimental-strip-types dev/schema.test.ts",
    "test:ingest": "node --experimental-strip-types dev/ingest.test.ts",
    "catalog:retry": "node --experimental-strip-types catalogs/retry.ts",
    "test:adapters": "node --experimental-strip-types dev/adapters.test.ts",
    "test:reader": "node --experimental-strip-types dev/reader.test.ts",
    "test:ai": "node --experimental-strip-types dev/ai.test.ts",
    "test:watch": "node --experimental-strip-types dev/watch.test.ts",
    "test:pipeline": "node --experimental-strip-types dev/pipeline.test.ts",
    "test:generate": "node --experimental-strip-types dev/generate.test.ts",
    "test:today": "node --experimental-strip-types dev/today.test.ts",
    "test:flash-deep": "node --experimental-strip-types dev/flash-deep.test.ts",
    "preview": "dev/preview.sh",
    "test:resolve": "node --experimental-strip-types dev/resolve.test.ts",
    "icon:build": "electron dev/make-icon.mjs",
    "package:prepare": "npm run reader:build && npm run build --workspace=@pnr/desktop && npm run build --workspace=@pnr/worker && node scripts/prepare-package.mjs",
    "package:dir": "npm run package:prepare && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --project apps/desktop/packaging/app --config ../../electron-builder.config.mjs --mac dir --arm64",
    "package:mac": "npm run package:prepare && PNR_RELEASE_SIGN=1 CSC_NAME='Yue Jing (PR3596G4YB)' electron-builder --project apps/desktop/packaging/app --config ../../electron-builder.config.mjs --mac dmg zip --arm64"
  },
  "devDependencies": {
    "electron-builder": "^26.15.3"
  }
}
