  <key>EnvironmentVariables</key>
  <dict>
    <key>ELECTRON_RUN_AS_NODE</key><string>1</string>
    <key>PNR_SCHEDULED_RUN</key><string>1</string>
    <key>PNR_WORKER_MODE</key><string>flashes</string>
