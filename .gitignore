node_modules/
dist/
out/
build/
release/
apps/desktop/packaging/
.vite/
*.tsbuildinfo

# Local secrets — never commit
.env
.env.*
!.env.example
*.p12
*.p8

# Local user data: the SQLite database, extracted article bodies, images.
# Anchored to the root — an unanchored `data/` also matches catalogs/data,
# which is the source catalogue and must be committed.
/data/
*.db
*.db-wal
*.db-shm

# Copied from catalogs/data at build time — not a second source of truth
apps/desktop/catalogs/

# Intermediate: build.ts writes this, verify.ts turns it into feeds.json
catalogs/data/candidates.json

# RSSHub writes log files even with NO_LOGFILES set; the adapter points
# LOGGER_DIR at the temp directory, this is the backstop
logs/

# Bundled third-party runtime, fetched at build time
vendor/rsshub/

# macOS
.DS_Store

# Build and signing artifacts
*.dmg
*.zip
*.app

# Transient: iconutil input, assembled and removed by dev/make-icon.mjs
assets/icon.iconset/
/native/reader/bin/
/dev/snapshots/

# CodeGraph local index (rebuilt via `codegraph init`)
.codegraph/
